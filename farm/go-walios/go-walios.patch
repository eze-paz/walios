+			now = nanotime()
+		}
+		if last := sched.lastpoll.Load(); last != 0 && now-last > 10*1000*1000 {
+			sched.lastpoll.Store(now)
+			if list, delta := netpoll(0); !list.empty() {
+				injectglist(&list)
+				netpollAdjustWaiters(delta)
+			}
+		}
+	}

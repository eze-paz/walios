+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build linux && wasm
+
+package runtime
+
+import (
+	"internal/runtime/syscall/linux"
+	"unsafe"
+)
+
+// The linux/wasm netpoller. The program is single-threaded (like wasip1), so the
+// scheduler calls netpoll only when nothing else can run; it is level-triggered
+// (poll_runtime_pollWait re-arms before every wait) and built on poll(2), which
+// also serves as the idle sleep until the next timer.
+
+const (
+	_SYS_poll = 7
+	_EINTR    = 4
+
+	_POLLIN  = 0x1
+	_POLLOUT = 0x4
+	_POLLERR = 0x8
+	_POLLHUP = 0x10
+)
+
+type pollfd struct {
+	fd      int32
+	events  int16
+	revents int16
+}
+
+type pollSub struct {
+	pd   uintptr // *pollDesc; uintptr so netpoll (no write barriers) can move entries
+	mode int32 // 'r' or 'w'
+}
+
+var (
+	psubs []pollSub
+	pfds  []pollfd
+	pds   []*pollDesc
+	mtx   mutex
+)
+
+func netpollinit() {
+	psubs = make([]pollSub, 0, 128)
+	pfds = make([]pollfd, 0, 128)
+	pds = make([]*pollDesc, 0, 128)
+}
+
+func netpollIsPollDescriptor(fd uintptr) bool {
+	return false
+}
+
+func netpollopen(fd uintptr, pd *pollDesc) int32 {
+	lock(&mtx)
+	pds = append(pds, pd)
+	unlock(&mtx)
+	return 0
+}
+
+func netpollarm(pd *pollDesc, mode int) {
+	lock(&mtx)
+	for _, s := range psubs {
+		if s.pd == uintptr(unsafe.Pointer(pd)) && s.mode == int32(mode) {
+			unlock(&mtx)
+			return
+		}
+	}
+	psubs = append(psubs, pollSub{pd: uintptr(unsafe.Pointer(pd)), mode: int32(mode)})
+	if cap(pfds) < len(psubs) {
+		pfds = make([]pollfd, 0, cap(psubs)) // grow here: netpoll runs on g0 and must not allocate
+	}
+	unlock(&mtx)
+}
+
+func netpolldisarm(pd *pollDesc, mode int32) {
+	for i := 0; i < len(psubs); {
+		s := psubs[i]
+		if s.pd == uintptr(unsafe.Pointer(pd)) && (mode == 'r'+'w' || s.mode == mode) {
+			psubs[i] = psubs[len(psubs)-1]
+			psubs = psubs[:len(psubs)-1]
+			continue
+		}
+		i++
+	}
+}
+
+func netpollclose(fd uintptr) int32 {
+	lock(&mtx)
+	for i := 0; i < len(pds); i++ {
+		if pds[i].fd == fd {
+			netpolldisarm(pds[i], 'r'+'w')
+			pds[i] = pds[len(pds)-1]
+			pds = pds[:len(pds)-1]
+			break
+		}
+	}
+	unlock(&mtx)
+	return 0
+}
+
+func netpollBreak() {}
+
+func netpoll(delay int64) (gList, int32) {
+	lock(&mtx)
+	if len(psubs) == 0 && delay < 0 {
+		unlock(&mtx)
+		return gList{}, 0
+	}
+	timeout := int64(-1)
+	if delay >= 0 {
+		timeout = (delay + 999999) / 1000000 // ns -> ms, rounded up
+		if timeout > 1<<30 {
+			timeout = 1 << 30
+		}
+	}
+	pfds = pfds[:len(psubs)] // netpollarm keeps cap(pfds) >= len(psubs): no append (allocation) here
+	for i, s := range psubs {
+		ev := int16(_POLLIN)
+		if s.mode == 'w' {
+			ev = _POLLOUT
+		}
+		pfds[i] = pollfd{fd: int32((*pollDesc)(unsafe.Pointer(s.pd)).fd), events: ev}
+	}
+	var p unsafe.Pointer
+	if len(pfds) > 0 {
+		p = unsafe.Pointer(&pfds[0])
+	}
+	_, _, e := linux.Syscall6(_SYS_poll, uintptr(p), uintptr(len(pfds)), uintptr(timeout), 0, 0, 0)
+	if e != 0 {
+		unlock(&mtx)
+		if e != _EINTR {
+			println("errno=", e, " len(pfds)=", len(pfds))
+			throw("poll failed")
+		}
+		return gList{}, 0
+	}
+	var toRun gList
+	delta := int32(0)
+	// Backwards, so removing entry i (swap with the last one, already visited)
+	// keeps psubs and pfds aligned for the entries still to visit.
+	for i := len(pfds) - 1; i >= 0; i-- {
+		f := pfds[i]
+		if f.revents == 0 {
+			continue
+		}
+		s := psubs[i]
+		last := len(psubs) - 1
+		psubs[i] = psubs[last]
+		psubs = psubs[:last]
+		pd := (*pollDesc)(unsafe.Pointer(s.pd))
+		pd.setEventErr(f.revents&_POLLERR != 0, 0)
+		delta += netpollready(&toRun, pd, s.mode)
+	}
+	unlock(&mtx)
+	return toRun, delta
+}

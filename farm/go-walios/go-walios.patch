@@ -0,0 +1,174 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build linux && wasm
+
+// linux/wasm: Go on a WALI kernel (walios, the in-browser Linux). The program is a
+// single-threaded wasm module like wasip1, but its system interface is Linux:
+// every syscall is the host import wali.SYS_<name> (internal/runtime/syscall/linux),
+// and argv/environment come from WALI's process-init imports.
+
+package runtime
+
+import (
+	"internal/runtime/syscall/linux"
+	"unsafe"
+)
+
+const (
+	_CLOCK_REALTIME  = 0
+	_CLOCK_MONOTONIC = 1
+	_GRND_NONBLOCK   = 1
+
+	_SYS_write         = 1
+	_SYS_nanosleep     = 35
+	_SYS_exit_group    = 231
+	_SYS_clock_gettime = 228
+	_SYS_getrandom     = 318
+	_SYS_openat        = 257
+	_SYS_read          = 0
+	_SYS_close         = 3
+)
+
+type linuxTimespec struct {
+	sec  int64
+	nsec int64
+}
+
+//go:wasmimport wali __cl_get_argc
+func wali_argc() int32
+
+//go:wasmimport wali __cl_get_argv_len
+func wali_argv_len(i int32) int32
+
+//go:wasmimport wali __cl_copy_argv
+//go:noescape
+func wali_copy_argv(buf unsafe.Pointer, i int32) int32
+
+// The environment arrives as a file named into buf (NUL-separated entries, like
+// /proc/self/environ); 0 = no environment.
+//
+//go:wasmimport wali __get_init_envfile0
+//go:noescape
+func wali_envfile(buf unsafe.Pointer, size int32) int32
+
+func exit(code int32) {
+	linux.Syscall6(_SYS_exit_group, uintptr(code), 0, 0, 0, 0, 0)
+	for {
+	}
+}
+
+func write1(fd uintptr, p unsafe.Pointer, n int32) int32 {
+	r, _, e := linux.Syscall6(_SYS_write, fd, uintptr(p), uintptr(n), 0, 0, 0)
+	if e != 0 {
+		return -int32(e)
+	}
+	return int32(r)
+}
+
+func usleep(usec uint32) {
+	ts := linuxTimespec{sec: int64(usec / 1e6), nsec: int64(usec%1e6) * 1e3}
+	linux.Syscall6(_SYS_nanosleep, uintptr(unsafe.Pointer(&ts)), 0, 0, 0, 0, 0)
+}
+
+func readRandom(r []byte) int {
+	if len(r) == 0 {
+		return 0
+	}
+	n, _, e := linux.Syscall6(_SYS_getrandom, uintptr(unsafe.Pointer(&r[0])), uintptr(len(r)), 0, 0, 0, 0)
+	if e != 0 {
+		return 0
+	}
+	return int(n)
+}
+
+func goenvs() {
+	argc := int(wali_argc())
+	argslice = make([]string, argc)
+	for i := range argslice {
+		n := wali_argv_len(int32(i))
+		buf := make([]byte, n+1)
+		wali_copy_argv(unsafe.Pointer(&buf[0]), int32(i))
+		argslice[i] = string(buf[:n])
+	}
+
+	var path [256]byte
+	if wali_envfile(unsafe.Pointer(&path[0]), int32(len(path))) == 0 {
+		return
+	}
+	fd, _, e := linux.Syscall6(_SYS_openat, ^uintptr(99) /* AT_FDCWD */, uintptr(unsafe.Pointer(&path[0])), 0, 0, 0, 0)
+	if e != 0 {
+		return
+	}
+	var data []byte
+	var chunk [4096]byte
+	for {
+		n, _, e := linux.Syscall6(_SYS_read, fd, uintptr(unsafe.Pointer(&chunk[0])), uintptr(len(chunk)), 0, 0, 0)
+		if e != 0 || n == 0 {
+			break
+		}
+		data = append(data, chunk[:n]...)
+	}
+	linux.Syscall6(_SYS_close, fd, 0, 0, 0, 0, 0)
+	start := 0
+	for i, c := range data {
+		if c == 0 {
+			if i > start {
+				envs = append(envs, string(data[start:i]))
+			}
+			start = i + 1
+		}
+	}
+}
+
+func walltime() (sec int64, nsec int32) {
+	return walltime1()
+}
+
+func walltime1() (sec int64, nsec int32) {
+	var ts linuxTimespec
+	linux.Syscall6(_SYS_clock_gettime, _CLOCK_REALTIME, uintptr(unsafe.Pointer(&ts)), 0, 0, 0, 0)
+	return ts.sec, int32(ts.nsec)
+}
+
+func nanotime1() int64 {
+	var ts linuxTimespec
+	linux.Syscall6(_SYS_clock_gettime, _CLOCK_MONOTONIC, uintptr(unsafe.Pointer(&ts)), 0, 0, 0, 0)
+	return ts.sec*1e9 + ts.nsec
+}
+
+//go:nowritebarrierrec
+//go:nosplit
+func libpreinit() {}
+
+//go:nowritebarrierrec
+//go:nosplit
+func newosproc0(stacksize uintptr, fn unsafe.Pointer) {
+	throw("bad newosproc0")
+}
+
+const _SYS_fcntl = 72
+
+// used in internal/syscall/unix
+//
+//go:linkname fcntl
+func fcntl(fd, cmd, arg int32) (ret int32, errno int32) {
+	r, _, e := linux.Syscall6(_SYS_fcntl, uintptr(fd), uintptr(cmd), uintptr(arg), 0, 0, 0)
+	return int32(r), int32(e)
+}
+
+// A single wasm thread: "all threads" is this one.
+//
+//go:linkname syscall_runtime_doAllThreadsSyscall syscall.runtime_doAllThreadsSyscall
+func syscall_runtime_doAllThreadsSyscall(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2, err uintptr) {
+	return linux.Syscall6(trap, a1, a2, a3, a4, a5, a6)
+}
+
+// No signal handling on linux/wasm yet (like wasip1): nothing to ignore or restore.
+//
+//go:linkname ignoreSIGSYS os.ignoreSIGSYS
+func ignoreSIGSYS() {}
+
+//go:linkname restoreSIGSYS os.restoreSIGSYS
+func restoreSIGSYS() {}

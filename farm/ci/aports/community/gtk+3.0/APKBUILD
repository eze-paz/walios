# walios farm override of Alpine's community/gtk+3.0: the X11 backend only (no Wayland/Broadway),
# no introspection, no colord/cups/cloudproviders/tracker, input methods built in (no immodule
# .so to dlopen), no demos/tests/man. Static library; programs link it (gtk3-hello).
pkgname=gtk+3.0
pkgver=3.24.52
pkgrel=0
pkgdesc="The GTK+ Toolkit (v3), X11 backend, for walios"
url="https://www.gtk.org/"
arch="all"
license="LGPL-2.1-or-later"
options="!check"
depends="shared-mime-info hicolor-icon-theme"
makedepends="
	gdk-pixbuf-dev glib-dev libepoxy-dev libxext-dev libxi-dev libxinerama-dev
	at-spi2-core-dev cairo-dev expat-dev fontconfig-dev libice-dev libx11-dev
	libxcomposite-dev libxcursor-dev libxdamage-dev libxfixes-dev libxrandr-dev
	pango-dev zlib-dev hicolor-icon-theme meson
	"
source="https://download.gnome.org/sources/gtk/${pkgver%.*}/gtk-$pkgver.tar.xz
	5628.patch
	events-Compress-touch-update-events.patch
	"
builddir="$srcdir/gtk-$pkgver"

build() {
	# glib's code generators run on the build machine: gio-2.0.pc / glib-2.0.pc name them at
	# overlay paths where they are missing (gdbus-codegen: "tool variable 'gdbus_codegen'
	# contains erroneous value", R92) or are wasm. The runner's own glib tools stand in.
	command -v gdbus-codegen >/dev/null || { sudo -n apt-get update -qq >/dev/null 2>&1; sudo -n apt-get install -y -qq libglib2.0-dev-bin >/dev/null 2>&1; } || true
	local t v h
	for t in gdbus_codegen:gio-2.0 glib_mkenums:glib-2.0 glib_genmarshal:glib-2.0 glib_compile_resources:gio-2.0 glib_compile_schemas:gio-2.0; do
		v=$(pkg-config --variable=${t%%:*} ${t#*:} 2>/dev/null)
		h=$(command -v $(printf %s "${t%%:*}" | tr _ -) 2>/dev/null)
		[ -n "$v" ] && [ -n "$h" ] || continue
		if [ ! -e "$v" ] || [ "$(head -c4 "$v" | od -An -tx1 | tr -d ' \n')" = 0061736d ]; then
			mkdir -p "$(dirname "$v")" && ln -sf "$h" "$v" && echo "gtk: $v -> $h"
		fi
	done
	abuild-meson \
		-Dx11_backend=true -Dwayland_backend=false -Dbroadway_backend=false \
		-Dintrospection=false -Dman=false -Dgtk_doc=false \
		-Ddemos=false -Dexamples=false -Dtests=false -Dinstalled_tests=false \
		-Dxinerama=yes -Dcolord=no -Dcloudproviders=false -Dtracker3=false -Dprofiler=false \
		-Dprint_backends=file -Dbuiltin_immodules=yes \
		output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}


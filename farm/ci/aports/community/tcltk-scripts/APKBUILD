# walios farm: Tcl's and Tk's script libraries (init.tcl, tk.tcl, msgcat, encodings, tzdata...)
# as data. A farm program package is its wasm alone, so tclsh/wish/_tkinter found no init.tcl
# ("application-specific initialization failed"). Installed where Alpine's tcl/tk put them.
pkgname=tcltk-scripts
pkgver=8.6.18
pkgrel=0
pkgdesc="Tcl and Tk script libraries for walios (tcl_library, tk_library)"
url="https://www.tcl-lang.org/"
arch="noarch"
license="TCL"
options="!check"
source="https://downloads.sourceforge.net/sourceforge/tcl/tcl$pkgver-src.tar.gz
	https://downloads.sourceforge.net/sourceforge/tcl/tk$pkgver-src.tar.gz
	"
builddir="$srcdir"

build() { :; }

package() {
	mkdir -p "$pkgdir"/usr/lib
	cp -r "$srcdir"/tcl$pkgver/library "$pkgdir"/usr/lib/tcl8.6
	cp -r "$srcdir"/tk$pkgver/library "$pkgdir"/usr/lib/tk8.6
	rm -rf "$pkgdir"/usr/lib/tk8.6/demos
}

sha512sums="

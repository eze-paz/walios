# walios farm override of Alpine's community/jwm: no SVG icons (librsvg pulls in rust/cairo),
# no cairo, no NLS; PNG/XPM icons and Xft text stay. A window manager for walios' Xvfb.
pkgname=jwm
pkgver=2.4.6
pkgrel=0
pkgdesc="A lightweight window manager for the X11 Window System"
options="!check"
url="https://joewing.net/projects/jwm/"
arch="all"
license="MIT"
makedepends="
	libpng-dev
	libx11-dev
	libxext-dev
	libxft-dev
	libxinerama-dev
	libxmu-dev
	libxpm-dev
	libxrender-dev
	"
source="https://github.com/joewing/jwm/releases/download/v$pkgver/jwm-$pkgver.tar.xz"

prepare() {
	default_prepare
	update_config_sub
	sed -i "s|@mkdir_p@|mkdir -p|g" po/Makefile.in.in
}

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-rpath \
		--disable-rsvg \
		--disable-cairo \
		--disable-jpeg \
		--disable-pango \
		--disable-nls
	make
}

package() {
	make DESTDIR="$pkgdir" install
}

sha512sums="
daf1bf033f2055534bab7ac5a12966df69039d3af2a220d1c9ce2126759019c9e6fea1a50fdf72d30be36d0cd22f243d11010d50f4b0795577b4d74209b82bd6  jwm-2.4.6.tar.xz
"

# walios farm override of Alpine's community/gdk-pixbuf: no glycin (Rust, sandboxed loader
# processes), no introspection; PNG and JPEG loaders built into the library (walios dlopen()s
# only side modules made for the program, so loader .so modules could never load).
pkgname=gdk-pixbuf
pkgver=2.44.8
pkgrel=0
pkgdesc="GTK+ image loading library (built-in PNG/JPEG loaders: walios)"
url="https://gitlab.gnome.org/GNOME/gdk-pixbuf"
arch="all"
license="LGPL-2.1-or-later"
options="!check"
depends="shared-mime-info"
makedepends="glib-dev libpng-dev libjpeg-turbo-dev meson"
source="https://download.gnome.org/sources/gdk-pixbuf/${pkgver%.*}/gdk-pixbuf-$pkgver.tar.xz
	pc.patch
	"

build() {
	abuild-meson 		-Dinstalled_tests=false -Dtests=false -Dman=false -Ddocumentation=false 		-Dintrospection=disabled -Dglycin=disabled 		-Dpng=enabled -Djpeg=enabled -Dtiff=disabled -Dgif=disabled -Dothers=disabled 		-Dbuiltin_loaders=all 		output .
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="

# walios farm: a small GTK3 program for the X display (see hello.c); clicks, toggles and entry
# text on stdout. Built against the farm's gtk+3.0 (X11 backend).
pkgname=gtk3-hello
pkgver=1
pkgrel=4
pkgdesc="GTK3 demo window for walios"
url="https://github.com/eze-paz/walios"
arch="all"
license="MIT"
options="!check"
depends="font-dejavu shared-mime-info hicolor-icon-theme"
makedepends="gtk+3.0-dev"
source="hello.c"
builddir="$srcdir"

build() {
	# (at-spi2's .pc injects -DG_LOG_DOMAIN=atspi unquoted: "undeclared identifier 'atspi'", R101b;
	#  static libs may be named by full path as -l/abs/x.a, as in sdl2.pc)
	# Constructors once, before main. crt1 never calls __wasm_call_ctors, so wasm-ld links a WASI
	# "command" and wraps EVERY export to re-run the constructors -- the thread entry included:
	# pango's fontconfig thread ran GObject's constructor again ("cannot register existing
	# fundamental type 'gchar'", R104). The cure CPython's runtime uses (walios
	# runtimes/cpython/wali_start.c): reference __wasm_call_ctors, run it from __main_void.
	cat > walistart.c <<'C'
extern void __wasm_call_ctors(void);
extern int __real___main_void(void);
int __wrap___main_void(void) { __wasm_call_ctors(); return __real___main_void(); }
C
	$CC $CFLAGS hello.c walistart.c -Wl,--wrap=__main_void $(pkg-config --cflags gtk+-3.0 | sed 's/ *-DG_LOG_DOMAIN=[^ ]*//g') \
		$(pkg-config --static --libs gtk+-3.0 | sed 's#-l/#/#g') -o gtk3-hello
	# GObject calls every class_init/instance_init through GClassInitFunc (2 params) while
	# G_DEFINE_TYPE's are declared with fewer; a wasm call_indirect traps on that ("function
	# signature mismatch" in type_class_init_Wm, R102). binaryen's fpcast-emu, as the farm does
	# for programs whose smoke traps -- GTK only reaches class_init once it opens a display.
	# (max-func-params: GTK has a 17-parameter function, R103; a failure here must fail the build)
	"${TC:?}"/binaryen/bin/wasm-opt --fpcast-emu --pass-arg=max-func-params@32 -O2 gtk3-hello -o gtk3-hello.fpc || return 1
	mv gtk3-hello.fpc gtk3-hello
}

package() {
	install -Dm755 gtk3-hello "$pkgdir"/usr/bin/gtk3-hello
}

sha512sums="
5f64d223e792361287f037f8985f5b89c895826ba6fbc8f4d2df4edd944a80a58d90aaa50ef97caaa1defe0b7850d4aeec264b334c71f3c54cacdc1aa48ab8ad  hello.c
"

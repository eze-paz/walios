# walios farm: tkinter for walios Python -- CPython 3.14.7's Lib/tkinter and Modules/_tkinter.c
# as a side module (python_cxx.wasm dlopen()s it) with Tk and Tcl linked in statically. Alpine
# builds _tkinter inside its python3 aport; walios' Python is its own build, so this is a
# separate package. The Tcl/Tk script libraries come from tcltk-scripts.
pkgname=py3-tkinter
pkgver=3.14.7
pkgrel=2
pkgdesc="tkinter (Tk GUI toolkit bindings) for walios Python"
url="https://docs.python.org/3/library/tkinter.html"
arch="all"
license="PSF-2.0"
options="!check"
depends="tcltk-scripts"
makedepends="python3-dev tcl-dev tk-dev libx11-dev libxft-dev fontconfig-dev py3-setuptools"
source="https://www.python.org/ftp/python/$pkgver/Python-$pkgver.tar.xz"
builddir="$srcdir/Python-$pkgver"

build() {
	# python_cxx.wasm exports no pthread_exit, and a side module may import only its exports;
	# Tcl's TclpThreadExit (Tcl_ExitThread, never reached from tkinter) is the one caller.
	cat > walios_pthread_exit.c <<'C'
#include <pthread.h>
_Noreturn void pthread_exit(void *r) { (void)r; __builtin_trap(); }
C
	cat > setup.py <<'PY'
import os, sysconfig
from setuptools import setup, Extension
ov = os.environ.get('OVERLAY', '')
inc = sysconfig.get_paths()['include']
# Tcl 8.6 by name: the farm's tcl9 owns /usr/include/tcl.h and tcl.pc (R91), so no pkg-config;
# the libraries Tk and Tcl link with are what their *Config.sh say (TK_LIBS, TCL_LIBS).
def cfg(f, k):
    try:
        for l in open(ov + f):
            if l.startswith(k + "="): return l.split("=", 1)[1].strip().strip("'").split()
    except OSError: pass
    return []
extra = [a for a in cfg('/usr/lib/tkConfig.sh', 'TK_LIBS') + cfg('/usr/lib/tcl8.6/tclConfig.sh', 'TCL_LIBS') if a.startswith('-l')]
libs = ['-ltk8.6', '-ltcl8.6'] + list(dict.fromkeys(extra + ['-lX11', '-lxcb', '-lXau', '-lXdmcp', '-lz', '-lm']))
print('py3-tkinter links:', ' '.join(libs))
setup(name='tkinter', version='3.14.7', package_dir={'': 'Lib'}, packages=['tkinter'],
      ext_modules=[Extension('_tkinter', ['Modules/_tkinter.c', 'walios_pthread_exit.c'],
                             include_dirs=[ov + '/usr/include/tcl8.6', ov + '/usr/include', 'Modules', os.path.join(inc, 'internal')],
                             library_dirs=[ov + '/usr/lib'], extra_link_args=libs)])
PY
	OVERLAY="$OVERLAY" python3 setup.py build
}

package() {
	python3 setup.py install --root="$pkgdir" --prefix=/usr --skip-build
}

sha512sums="
3d4e2e2f983b320dec47005c408d7178d3656a6de0c4430ce21514797174b972f461200898b25d3dfac2a455019ef87e45d0fb2bb6ec2ca887124d10037a2a07  Python-3.14.7.tar.xz
"

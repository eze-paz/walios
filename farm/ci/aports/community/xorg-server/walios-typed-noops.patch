-    if ((grab && SameClient(grab, client) &&
-         ((grab->eventMask & PointerMotionHintMask) ||
-          (grab->ownerEvents &&
-           (EventMaskForClient(dev->valuator->motionHintWindow, client) &
-            PointerMotionHintMask)))) ||

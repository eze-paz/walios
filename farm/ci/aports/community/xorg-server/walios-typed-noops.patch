+{
+    miScreenInitParmsPtr pScrInitParms;
+    void *value;
+
+    pScrInitParms = (miScreenInitParmsPtr) pScreen->devPrivate;
+
+    /* if width is non-zero, pScreen->devPrivate will be a pixmap
+     * else it will just take the value pbits

# walios farm override of Alpine's community/xorg-server: builds ONLY Xvfb, the virtual
# framebuffer X server (no Xorg/Xephyr/Xnest, no GL, DRM, udev, PCI, SHM, input thread).
# Clients reach it over TCP 127.0.0.1:6000+N (walios has no AF_UNIX socket() yet).
pkgname=xorg-server
pkgver=21.1.26
pkgrel=0
pkgdesc="X.Org virtual framebuffer X server (Xvfb) for walios"
url="https://www.x.org/wiki"
arch="all"
license="MIT"
options="!check"
depends="font-cursor-misc font-misc-misc xkbcomp xkeyboard-config"
makedepends="
	libxau
	libxfont2
	libxkbfile
	pixman
	xorgproto
	xtrans
	"
source="https://www.x.org/releases/individual/xserver/xorg-server-$pkgver.tar.xz"

build() {
	abuild-meson \
		-Dxorg=false \
		-Dxephyr=false \
		-Dxnest=false \
		-Dxvfb=true \
		-Dxwin=false \
		-Dglamor=false \
		-Dglx=false \
		-Ddri1=false \
		-Ddri2=false \
		-Ddri3=false \
		-Ddrm=false \
		-Dudev=false \
		-Dudev_kms=false \
		-Dpciaccess=false \
		-Dhal=false \
		-Dsystemd_logind=false \
		-Dsuid_wrapper=false \
		-Dint10=false \
		-Dvgahw=false \
		-Dagp=false \
		-Ddga=false \
		-Dlinux_apm=false \
		-Dlinux_acpi=false \
		-Dxdmcp=false \
		-Dxdm-auth-1=false \
		-Dsecure-rpc=false \
		-Dxselinux=false \
		-Dlibunwind=false \
		-Dinput_thread=false \
		-Dmitshm=false \
		-Ddtrace=false \
		-Ddocs=false \
		-Ddevel-docs=false \
		-Dsha1=libcrypto \
		-Dipv6=true \
		-Dlisten_tcp=true \
		-Dlisten_unix=true \
		-Dlisten_local=false \
		-Dxkb_dir=/usr/share/X11/xkb \
		-Dxkb_bin_dir=/usr/bin \
		-Dxkb_output_dir=/tmp \
		-Ddefault_font_path=/usr/share/fonts/misc,built-ins \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
dbf13bcfc3f6bcc0d2ad201d993003d0f4e583f1eae8e39f9a4c13418ac1ce459ba3f1f79a060b98f6731839048e1962b2f03e6aaf1b03b3fa83bdfc01eddd86  xorg-server-21.1.26.tar.xz
"

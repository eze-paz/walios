 #endif /* TCL_THREADS */
 
 /*
+ * walios (wasm): proc is a void (ClientData) function. Started through a cast to the
+ * void *(*)(void *) pthread_create wants, the wasm call_indirect traps ("function signature
+ * mismatch") -- the notifier thread of every threaded Tcl died that way. A trampoline of the
+ * right type calls it instead.
+ */
+typedef struct {
+    Tcl_ThreadCreateProc *proc;
+    ClientData clientData;
+} WaliThreadStart;
+
+static void *
+WaliThreadTrampoline(
+    void *arg)
+{
+    WaliThreadStart ws = *(WaliThreadStart *) arg;
+
+    free(arg);
+    ws.proc(ws.clientData);
+    return NULL;
+}
+
+/*
  *----------------------------------------------------------------------
  *
  * TclpThreadCreate --
@@ -118,10 +140,16 @@

-	    (void * (*)(void *))(void *)proc, (void *)clientData) &&
-	    pthread_create(&theThread, NULL,
-		    (void * (*)(void *))(void *)proc, (void *)clientData)) {
+    WaliThreadStart *ws = (WaliThreadStart *) malloc(sizeof(WaliThreadStart));
+
+    if (ws == NULL) {
+	return TCL_ERROR;
+    }
+    ws->proc = proc;
+    ws->clientData = clientData;
+    if (pthread_create(&theThread, &attr, WaliThreadTrampoline, ws) &&

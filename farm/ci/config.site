# Farm autoconf site file: the cross-compile cache answers of farm/config.site, plus static
# libraries only (walios executables link statically; the wrapper turns -shared into an
# archive anyway, so a "shared" libfoo would just be built twice).
. "$FARM_CI_DIR/../config.site"
# (build-one.sh's retry after libtool's "cannot build a shared library" -- a -module that only
# builds shared, util-linux's pam_lastlog2 -- sets FARM_SHARED=yes)
enable_shared=${FARM_SHARED:-no}
enable_static=yes
# Always a cross build, even when a recipe runs ./configure without --host: otherwise
# AC_PROG_CC tries to RUN a test program ("cannot run C compiled programs").
# R43 tried native mode (cross_compiling=maybe, test programs run through binfmt wali-run):
# +3 (cdparanoia, ucarp, perl-socket6) but -3 core ones with many dependents -- ncurses and flex
# then build their host-side generators for wasm (gcc got clang's -Qunused-arguments; flex's
# stage1flex ran under wali-run and crashed), pcre2's configure stopped. cmake's
# CROSSCOMPILING_EMULATOR and meson's exe_wrapper stay: they keep the build a cross build.
# (build-one.sh's one retry after a check a cross build cannot answer sets FARM_CROSS=no: with
# maybe, apr/cgdb/ICU still came out "cross compiling... yes" in R47 though a wasm program ran
# through binfmt there -- no makes configure run its test program and fail loudly if it can't)
cross_compiling=${FARM_CROSS:-yes}
# No JIT backend targets wasm (pcre2's sljit: "Unsupported architecture"); Alpine enables
# it for every arch it knows. config.site is read after the command line, so this wins.
enable_jit=no
# wasm objects have no ELF symbol versions (.symver): elfutils' configure stops with "Symbol
# versioning is not supported" unless told; an explicit --enable-symbol-versioning still wins.
enable_symbol_versioning=${enable_symbol_versioning-no}
# Run-test answers for clang/musl/wasm that a cross build cannot find out (fontconfig in R55:
# "cannot run test program while cross compiling" at OSSP's va_copy.m4, then its C99 vsnprintf).
ac_cv_va_copy=${ac_cv_va_copy-C99}
fc_cv_c99_vsnprintf=${fc_cv_c99_vsnprintf-yes}
